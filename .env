PORT=3000
JWT_SECRET=change-me-to-a-long-random-string

# --- Postgres (Neon / Supabase / Render / local). Use a NON-superuser role so Row Level Security applies.
DATABASE_URL=postgres://lab:lab@localhost:5432/saas
PG_SSL=false
PG_POOL_MAX=10

# --- Kafka (local Redpanda via docker compose, or Aiven / Redpanda Cloud / Confluent)
KAFKA_BROKERS=localhost:19092
KAFKA_SSL=false
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_TOPIC=tenant.orders
KAFKA_GROUP_ID=inventory-service
KAFKA_PARTITIONS=3
KAFKA_IDEMPOTENT=true
# kafkajs (default) | memory  (memory = single-process dev mode, needs RUN_CONSUMER=true)
KAFKA_DRIVER=kafkajs

# Start the consumer inside the web process (handy on a single free Render service)
RUN_CONSUMER=false

# Serverless invoice worker (Vercel). Leave empty to disable.
INVOICE_WORKER_URL=
WORKER_SECRET=change-me-shared-secret
